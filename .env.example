# Client-safe values
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only values
CLERK_SECRET_KEY=
DATABASE_URL=
# Optional for migrations/admin tooling; runtime uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
STRIPE_SECRET_KEY=
# Signing secret for platform-account events: subscriptions and PaymentIntents.
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect destination that receives connected-account events.
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
GEMINI_API_KEY=
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
# Optional on Vercel; BuildMate derives the production URL automatically.
APP_URL=
ADMIN_CLERK_USER_IDS=

# Cloudinary media storage
# BuildMate defaults to qrrcn7ma, so the cloud-name values are optional overrides.
CLOUDINARY_CLOUD_NAME=qrrcn7ma
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=qrrcn7ma
