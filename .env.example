# Client-safe values
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only values
CLERK_SECRET_KEY=
DATABASE_URL=
# Optional for migrations/admin tooling; runtime uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
STRIPE_SECRET_KEY=
STRIPE_BASIC_PRICE_ID=
STRIPE_FEATURED_PRICE_ID=
# Signing secret for platform-account events: subscriptions and PaymentIntents.
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect destination that receives connected-account events.
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
# Keep true while paid billing is intentionally disabled for private beta.
# Set false when Stripe subscriptions are deliberately launched.
BUILDPAIR_BETA_LEAD_GRACE=true
# Explicitly controls whether clearly labelled, non-interactive beta preview jobs/profiles are shown.
# Turn this off for a real-data-only marketplace without changing code or migration history.
BUILDPAIR_PREVIEW_DATA_ENABLED=true
GEMINI_API_KEY=
RESEND_API_KEY=
INVOICE_FROM_EMAIL=BuildPair <info@buildpair.co.uk>
SUPPORT_EMAIL=info@buildpair.co.uk
# Set to https://buildpair.co.uk once the domain is attached to production.
APP_URL=
ADMIN_CLERK_USER_IDS=

# Cloudinary media storage
# BuildPair defaults to qrrcn7ma, so the cloud-name values are optional overrides.
CLOUDINARY_CLOUD_NAME=qrrcn7ma
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=qrrcn7ma
