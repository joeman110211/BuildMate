# Client-safe values
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only values
CLERK_SECRET_KEY=
DATABASE_URL=
# Optional for migrations/admin tooling; runtime uses DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Payments are release-gated. Keep this off for the private beta even if Stripe
# keys are present. Turning it on makes subscriptions/tier expiry enforceable.
BUILDPAIR_PAYMENTS_ENABLED=off
STRIPE_SECRET_KEY=
STRIPE_BASIC_PRICE_ID=
STRIPE_FEATURED_PRICE_ID=
# Signing secret for platform-account events: subscriptions and PaymentIntents.
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect destination that receives connected-account events.
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
GEMINI_API_KEY=
RESEND_API_KEY=
INVOICE_FROM_EMAIL=BuildPair <info@buildpair.co.uk>
SUPPORT_EMAIL=info@buildpair.co.uk
# Set to https://buildpair.co.uk once the domain is attached to production.
APP_URL=
ADMIN_CLERK_USER_IDS=

# Controlled beta preview data. Production defaults to off unless this is explicitly enabled.
# Use "append" to show labelled preview traders/jobs alongside live records, or "off" for live-only data.
BUILDPAIR_PREVIEW_DATA=off

# Cloudinary media storage
# BuildPair defaults to qrrcn7ma, so the cloud-name values are optional overrides.
CLOUDINARY_CLOUD_NAME=qrrcn7ma
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=qrrcn7ma
